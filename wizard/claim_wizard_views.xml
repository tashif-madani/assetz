<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Claim Reject Wizard Form -->
    <record id="view_assetz_claim_reject_wizard_form" model="ir.ui.view">
        <field name="name">assetz.claim.reject.wizard.form</field>
        <field name="model">assetz.claim.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Claim">
                <group>
                    <field name="claim_id" readonly="1" />
                </group>
                <group>
                    <field
                        name="reason"
                        placeholder="Please provide a reason for rejection..."
                    />
                </group>
                <footer>
                    <button
                        name="action_reject"
                        string="Reject Claim"
                        type="object"
                        class="btn-danger"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Claim Partial Approve Wizard Form -->
    <record id="view_assetz_claim_partial_approve_wizard_form" model="ir.ui.view">
        <field name="name">assetz.claim.partial.approve.wizard.form</field>
        <field name="model">assetz.claim.partial.approve.wizard</field>
        <field name="arch" type="xml">
            <form string="Partial Approval">
                <group>
                    <group>
                        <field name="claim_id" readonly="1" />
                        <field name="total_claimed" />
                        <field name="currency_id" invisible="1" />
                    </group>
                    <group>
                        <field name="approved_amount" />
                    </group>
                </group>
                <group>
                    <field
                        name="response"
                        placeholder="Explanation for partial approval..."
                    />
                </group>
                <footer>
                    <button
                        name="action_partial_approve"
                        string="Partially Approve"
                        type="object"
                        class="btn-warning"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
