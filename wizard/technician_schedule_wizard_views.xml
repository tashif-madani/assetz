<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Technician Schedule Wizard Form View -->
    <record id="view_technician_schedule_wizard_form" model="ir.ui.view">
        <field name="name">assetz.technician.schedule.wizard.form</field>
        <field name="model">assetz.technician.schedule.wizard</field>
        <field name="arch" type="xml">
            <form string="Schedule Technicians">
                <field name="state" invisible="1"/>
                <field name="order_id" invisible="1" force_save="1"/>

                <!-- Header Info -->
                <group>
                    <group string="Maintenance Order">
                        <field name="order_name" readonly="1"/>
                        <field name="asset_id" readonly="1"/>
                        <field name="asset_category_id" readonly="1"/>
                        <field name="maintenance_type" readonly="1"/>
                    </group>
                    <group string="Schedule">
                        <field name="scheduled_date" readonly="1"/>
                        <field name="asset_location_id" readonly="1"/>
                        <field name="team_id" readonly="1"/>
                    </group>
                </group>

                <!-- Select State -->
                <group invisible="state != 'select'">
                    <div class="alert alert-info" role="alert">
                        <strong>Select Technicians</strong>
                        <p class="mb-0">
                            Select available technicians to assign to this maintenance order.
                            Use "AI Suggest" for smart recommendations based on skills, availability, and workload.
                        </p>
                    </div>

                    <!-- AI Recommendation Section -->
                    <group string="AI Recommendations" invisible="not ai_recommendation">
                        <field name="ai_recommendation" readonly="1" nolabel="1" colspan="2"/>
                    </group>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-2 mb-3">
                        <button name="action_ai_suggest"
                                string="AI Suggest"
                                type="object"
                                class="btn-secondary"
                                icon="fa-magic"/>
                        <button name="action_refresh"
                                string="Refresh Availability"
                                type="object"
                                class="btn-secondary"
                                icon="fa-refresh"/>
                    </div>

                    <!-- Technician Grid -->
                    <field name="technician_line_ids" nolabel="1">
                        <list editable="bottom"
                              decoration-success="availability_status == 'available' and has_required_skills"
                              decoration-warning="availability_status == 'partial'"
                              decoration-danger="availability_status == 'busy'"
                              decoration-muted="not has_required_skills">
                            <field name="selected" widget="boolean_toggle"/>
                            <field name="employee_id" readonly="1" force_save="1"/>
                            <field name="availability_status" widget="badge"
                                   decoration-success="availability_status == 'available'"
                                   decoration-warning="availability_status == 'partial'"
                                   decoration-danger="availability_status == 'busy'"
                                   readonly="1" force_save="1"/>
                            <field name="available_hours" readonly="1" force_save="1"/>
                            <field name="scheduled_orders" readonly="1" force_save="1"/>
                            <field name="skill_match_score" widget="progressbar"
                                   options="{'max_value': 100}" readonly="1" force_save="1"/>
                            <field name="has_required_skills" readonly="1" force_save="1"/>
                            <field name="availability_details" column_invisible="1" force_save="1"/>
                        </list>
                    </field>

                    <!-- Legend -->
                    <div class="text-muted small mt-2">
                        <span class="badge text-bg-success me-2">Available</span> 4+ hours free
                        <span class="badge text-bg-warning me-2 ms-3">Partial</span> &lt;4 hours free
                        <span class="badge text-bg-danger me-2 ms-3">Busy</span> No availability
                    </div>
                </group>

                <!-- Preview State -->
                <group invisible="state != 'preview'">
                    <div class="alert alert-success" role="alert">
                        <strong>Review Labor Lines</strong>
                        <p class="mb-0">
                            Review and adjust the labor lines before adding them to the maintenance order.
                        </p>
                    </div>

                    <field name="preview_labor_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="employee_id"/>
                            <field name="date"/>
                            <field name="hours"/>
                            <field name="hourly_rate"/>
                            <field name="amount" sum="Total"/>
                            <field name="description"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </group>

                <footer>
                    <!-- Select State Buttons -->
                    <button name="action_proceed_to_preview"
                            string="Continue"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'select'"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            invisible="state != 'select'"/>

                    <!-- Preview State Buttons -->
                    <button name="action_confirm"
                            string="Add to Order"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'preview'"/>
                    <button name="action_back"
                            string="Back"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'preview'"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            invisible="state != 'preview'"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_technician_schedule_wizard" model="ir.actions.act_window">
        <field name="name">Schedule Technicians</field>
        <field name="res_model">assetz.technician.schedule.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
