<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Asset Sequence -->
        <record id="seq_assetz_asset" model="ir.sequence">
            <field name="name">Asset Sequence</field>
            <field name="code">assetz.asset</field>
            <field name="prefix">AST-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False" />
        </record>

        <!-- Asset Serial Number Sequence -->
        <record id="seq_assetz_asset_serial" model="ir.sequence">
            <field name="name">Asset Serial Number Sequence</field>
            <field name="code">assetz.asset.serial</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False" />
        </record>

        <!-- Asset Movement Sequence -->
        <record id="seq_assetz_asset_movement" model="ir.sequence">
            <field name="name">Asset Movement Sequence</field>
            <field name="code">assetz.asset.movement</field>
            <field name="prefix">MOV-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False" />
        </record>

        <!-- Issue Order Sequence -->
        <record id="seq_assetz_issue_order" model="ir.sequence">
            <field name="name">Issue Order Sequence</field>
            <field name="code">assetz.issue.order</field>
            <field name="prefix">ISS-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False" />
        </record>

        <!-- Asset Request Sequence -->
        <record id="seq_assetz_asset_request" model="ir.sequence">
            <field name="name">Asset Request Sequence</field>
            <field name="code">assetz.asset.request</field>
            <field name="prefix">REQ-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False" />
        </record>

        <!-- Asset Reservation Sequence -->
        <record id="seq_assetz_reservation" model="ir.sequence">
            <field name="name">Asset Reservation Sequence</field>
            <field name="code">assetz.reservation</field>
            <field name="prefix">RES-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False" />
        </record>

        <!-- Purchase Request Sequence -->
        <record id="seq_assetz_purchase_request" model="ir.sequence">
            <field name="name">Purchase Request Sequence</field>
            <field name="code">assetz.purchase.request</field>
            <field name="prefix">PR-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False" />
        </record>

        <!-- Service Contract Sequence -->
        <record id="seq_assetz_service_contract" model="ir.sequence">
            <field name="name">Service Contract Sequence</field>
            <field name="code">assetz.service.contract</field>
            <field name="prefix">SC-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False" />
        </record>

        <!-- Warranty Claim Sequence -->
        <record id="seq_assetz_warranty_claim" model="ir.sequence">
            <field name="name">Warranty Claim Sequence</field>
            <field name="code">assetz.warranty.claim</field>
            <field name="prefix">WC-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False" />
        </record>

        <!-- Maintenance Order Sequence -->
        <record id="seq_assetz_maintenance_order" model="ir.sequence">
            <field name="name">Maintenance Order Sequence</field>
            <field name="code">assetz.maintenance.order</field>
            <field name="prefix">MO-</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False" />
        </record>

        <!-- Maintenance Schedule Sequence -->
        <record id="seq_assetz_maintenance_schedule" model="ir.sequence">
            <field name="name">Maintenance Schedule Sequence</field>
            <field name="code">assetz.maintenance.schedule</field>
            <field name="prefix">SCH-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False" />
        </record>

        <!-- Checklist Template Sequence -->
        <record id="seq_assetz_checklist_template" model="ir.sequence">
            <field name="name">Checklist Template Sequence</field>
            <field name="code">assetz.checklist.template</field>
            <field name="prefix">CLT-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False" />
        </record>

        <!-- Service and Rental order sequences are now provided by sale.order
             (standard SO… sequence) and sale_renting respectively. Removed. -->

        <!-- Job number (Assetz FSM task identifier — separate from the
             sale.order's SO… number so the field crew has a stable
             job reference). Mirrors IWS's JOB/<year>/##### style. -->
        <record id="seq_assetz_job_number" model="ir.sequence">
            <field name="name">Assetz Job Number</field>
            <field name="code">assetz.job.number</field>
            <field name="prefix">JOB/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False" />
        </record>

        <!-- Agreement Sequence -->
        <record id="seq_assetz_agreement" model="ir.sequence">
            <field name="name">Agreement Sequence</field>
            <field name="code">assetz.agreement</field>
            <field name="prefix">AGR-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False" />
        </record>
    </data>
</odoo>
