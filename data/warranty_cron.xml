<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Service Contract Expiry Check Cron Job -->
        <record id="ir_cron_check_contract_expiry" model="ir.cron">
            <field name="name">Assetz: Check Contract Expiry</field>
            <field name="model_id" ref="model_assetz_service_contract" />
            <field name="state">code</field>
            <field name="code">model._cron_check_contract_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- Warranty Claim Follow-up Cron Job -->
        <record id="ir_cron_warranty_claim_followup" model="ir.cron">
            <field name="name">Assetz: Warranty Claim Follow-up</field>
            <field name="model_id" ref="model_assetz_warranty_claim" />
            <field name="state">code</field>
            <field name="code">model._cron_claim_followup()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
