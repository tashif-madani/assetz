<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!-- EOL Reminder Cron Job -->
        <record id="ir_cron_eol_reminder" model="ir.cron">
            <field name="name">Assetz: EOL Reminder Notification</field>
            <field name="model_id" ref="model_assetz_asset" />
            <field name="state">code</field>
            <field name="code">model._cron_eol_reminder()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- Expired Reservation Check Cron Job -->
        <record id="ir_cron_check_expired_reservations" model="ir.cron">
            <field name="name">Assetz: Check Expired Reservations</field>
            <field name="model_id" ref="model_assetz_reservation" />
            <field name="state">code</field>
            <field name="code">model._cron_check_expired_reservations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- Preventive Maintenance Schedule Check Cron Job -->
        <record id="ir_cron_check_preventive_maintenance" model="ir.cron">
            <field name="name">Assetz: Check Preventive Maintenance Schedules</field>
            <field name="model_id" ref="model_assetz_maintenance_schedule" />
            <field name="state">code</field>
            <field name="code">model._cron_check_maintenance_due()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=6, minute=0, second=0))"/>
        </record>
    </data>
</odoo>
