<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Service Contract Rules -->
    <record id="assetz_service_contract_company_rule" model="ir.rule">
        <field name="name">Service Contract: Multi-company</field>
        <field name="model_id" ref="model_assetz_service_contract" />
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Warranty Claim Rules -->
    <record id="assetz_warranty_claim_company_rule" model="ir.rule">
        <field name="name">Warranty Claim: Multi-company</field>
        <field name="model_id" ref="model_assetz_warranty_claim" />
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="assetz_warranty_claim_rule_user" model="ir.rule">
        <field name="name">Warranty Claim: User can view all claims</field>
        <field name="model_id" ref="model_assetz_warranty_claim" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="False" />
        <field name="groups" eval="[(4, ref('group_assetz_user'))]" />
    </record>

    <record id="assetz_warranty_claim_rule_manager" model="ir.rule">
        <field name="name">Warranty Claim: Manager has full access</field>
        <field name="model_id" ref="model_assetz_warranty_claim" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_assetz_manager'))]" />
    </record>
</odoo>
