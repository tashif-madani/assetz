<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Maintenance Team Views                                        -->
    <!-- ============================================================ -->

    <!-- Form View -->
    <record id="assetz_maintenance_team_form" model="ir.ui.view">
        <field name="name">assetz.maintenance.team.form</field>
        <field name="model">assetz.maintenance.team</field>
        <field name="arch" type="xml">
            <form string="Maintenance Team">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_members" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="member_count" widget="statinfo" string="Members"/>
                        </button>
                        <button name="action_view_orders" type="object"
                                class="oe_stat_button" icon="fa-wrench">
                            <field name="order_count" widget="statinfo" string="Orders"/>
                        </button>
                        <button name="action_view_pending_orders" type="object"
                                class="oe_stat_button" icon="fa-clock-o"
                                invisible="pending_order_count == 0">
                            <field name="pending_order_count" widget="statinfo" string="Pending"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., HVAC Team"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Team Information">
                            <field name="leader_id"/>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                        </group>
                        <group string="Settings">
                            <field name="sequence"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Team Members" name="members">
                            <field name="member_ids" widget="many2many"
                                   options="{'no_create': True}">
                                <list>
                                    <field name="name"/>
                                    <field name="job_title"/>
                                    <field name="work_email"/>
                                    <field name="work_phone"/>
                                    <field name="department_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="assetz_maintenance_team_list" model="ir.ui.view">
        <field name="name">assetz.maintenance.team.list</field>
        <field name="model">assetz.maintenance.team</field>
        <field name="arch" type="xml">
            <list string="Maintenance Teams">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="leader_id"/>
                <field name="member_count"/>
                <field name="order_count"/>
                <field name="pending_order_count"/>
                <field name="completed_order_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="assetz_maintenance_team_kanban" model="ir.ui.view">
        <field name="name">assetz.maintenance.team.kanban</field>
        <field name="model">assetz.maintenance.team</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" quick_create="false">
                <field name="name"/>
                <field name="leader_id"/>
                <field name="member_count"/>
                <field name="pending_order_count"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="#{!selection_mode ? kanban_color(record.color.raw_value) : ''}">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div t-if="record.leader_id.raw_value">
                                        <i class="fa fa-user"/> <field name="leader_id"/>
                                    </div>
                                    <div>
                                        <i class="fa fa-users"/> <field name="member_count"/> members
                                    </div>
                                    <div t-if="record.pending_order_count.raw_value > 0">
                                        <span class="badge rounded-pill text-bg-warning">
                                            <field name="pending_order_count"/> pending
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="assetz_maintenance_team_search" model="ir.ui.view">
        <field name="name">assetz.maintenance.team.search</field>
        <field name="model">assetz.maintenance.team</field>
        <field name="arch" type="xml">
            <search string="Search Teams">
                <field name="name"/>
                <field name="leader_id"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Actions                                                       -->
    <!-- ============================================================ -->

    <record id="action_maintenance_team" model="ir.actions.act_window">
        <field name="name">Maintenance Teams</field>
        <field name="res_model">assetz.maintenance.team</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="assetz_maintenance_team_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first maintenance team
            </p>
            <p>
                Organize technicians into teams for better workload management.
            </p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Menu Items                                                    -->
    <!-- ============================================================ -->

    <menuitem id="menu_config_maintenance_teams"
              name="Maintenance Teams"
              parent="assetz_menu_configuration"
              action="action_maintenance_team"
              sequence="51" />

</odoo>
