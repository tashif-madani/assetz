<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Maintenance Schedule Views                                    -->
    <!-- ============================================================ -->

    <!-- Form View -->
    <record id="assetz_maintenance_schedule_form" model="ir.ui.view">
        <field name="name">assetz.maintenance.schedule.form</field>
        <field name="model">assetz.maintenance.schedule</field>
        <field name="arch" type="xml">
            <form string="Maintenance Schedule">
                <header>
                    <button name="action_activate" string="Activate"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_pause" string="Pause"
                            type="object"
                            invisible="state != 'active'"/>
                    <button name="action_activate" string="Resume"
                            type="object" class="btn-primary"
                            invisible="state != 'paused'"/>
                    <button name="action_draft" string="Reset to Draft"
                            type="object"
                            invisible="state not in ('paused',)"/>
                    <button name="action_generate_orders" string="Generate Orders Now"
                            type="object" class="btn-secondary"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assets" type="object"
                                class="oe_stat_button" icon="fa-cubes">
                            <field name="asset_count" widget="statinfo" string="Assets"/>
                        </button>
                        <button name="action_view_orders" type="object"
                                class="oe_stat_button" icon="fa-wrench">
                            <field name="order_count" widget="statinfo" string="Orders"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Active" bg_color="text-bg-success"
                            invisible="state != 'active'"/>
                    <widget name="web_ribbon" title="Paused" bg_color="text-bg-warning"
                            invisible="state != 'paused'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., Monthly HVAC Inspection"/>
                        </h1>
                        <field name="code" readonly="1"/>
                    </div>
                    <group>
                        <group string="Schedule Type">
                            <field name="schedule_type" widget="radio"/>
                            <field name="maintenance_type"/>
                            <field name="priority"/>
                        </group>
                        <group string="Assignment">
                            <field name="apply_to_category"/>
                            <field name="category_id"
                                   invisible="not apply_to_category"
                                   required="apply_to_category"/>
                            <field name="asset_ids" widget="many2many_tags"
                                   invisible="apply_to_category"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Time-Based Settings -->
                        <page string="Time-Based Schedule" name="time_based"
                              invisible="schedule_type == 'usage_based'">
                            <group>
                                <group string="Interval">
                                    <label for="interval_number"/>
                                    <div class="o_row">
                                        <span>Every</span>
                                        <field name="interval_number" class="oe_inline" style="width: 60px;"/>
                                        <field name="interval_type" class="oe_inline"/>
                                    </div>
                                    <field name="start_date"/>
                                    <field name="lead_days"/>
                                </group>
                                <group string="Next Schedule">
                                    <field name="last_order_date"/>
                                    <field name="next_order_date"/>
                                </group>
                            </group>
                        </page>

                        <!-- Usage-Based Settings -->
                        <page string="Usage-Based Schedule" name="usage_based"
                              invisible="schedule_type == 'time_based'">
                            <group>
                                <group string="Usage Trigger">
                                    <field name="usage_metric"/>
                                    <label for="usage_threshold"/>
                                    <div class="o_row">
                                        <span>Every</span>
                                        <field name="usage_threshold" class="oe_inline"/>
                                        <field name="usage_unit" class="oe_inline"
                                               placeholder="e.g., hours, km"/>
                                    </div>
                                </group>
                                <group string="Tracking">
                                    <field name="last_usage_reading"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert">
                                <strong>Note:</strong> Usage-based schedules require that assets have
                                their usage counters (Operating Hours, Mileage, or Cycles) updated regularly.
                            </div>
                        </page>

                        <!-- Configuration -->
                        <page string="Configuration" name="config">
                            <group>
                                <group string="Work Order Defaults">
                                    <field name="checklist_template_id"
                                           options="{'no_create': True}"/>
                                    <field name="default_technician_id"/>
                                    <field name="team_id"/>
                                </group>
                                <group string="Other Settings">
                                    <field name="active"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                </group>
                            </group>
                            <group>
                                <field name="description" placeholder="Description of this maintenance schedule..."/>
                            </group>
                        </page>

                        <!-- Generated Orders -->
                        <page string="Generated Orders" name="orders">
                            <field name="order_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="asset_id"/>
                                    <field name="scheduled_date"/>
                                    <field name="technician_id"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="assetz_maintenance_schedule_list" model="ir.ui.view">
        <field name="name">assetz.maintenance.schedule.list</field>
        <field name="model">assetz.maintenance.schedule</field>
        <field name="arch" type="xml">
            <list string="Maintenance Schedules"
                  decoration-success="state == 'active'"
                  decoration-warning="state == 'paused'"
                  decoration-muted="state == 'draft'">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="schedule_type"/>
                <field name="maintenance_type"/>
                <field name="category_id"/>
                <field name="asset_count"/>
                <field name="next_order_date"/>
                <field name="order_count"/>
                <field name="pending_order_count" string="Pending"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'paused'"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="assetz_maintenance_schedule_kanban" model="ir.ui.view">
        <field name="name">assetz.maintenance.schedule.kanban</field>
        <field name="model">assetz.maintenance.schedule</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" quick_create="false">
                <field name="name"/>
                <field name="schedule_type"/>
                <field name="next_order_date"/>
                <field name="state"/>
                <field name="asset_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content">
                            <div class="o_kanban_record_top">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <field name="state" widget="label_selection"
                                       options="{'classes': {'draft': 'secondary', 'active': 'success', 'paused': 'warning'}}"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <span class="badge rounded-pill text-bg-info">
                                        <field name="schedule_type"/>
                                    </span>
                                </div>
                                <div t-if="record.next_order_date.raw_value">
                                    <i class="fa fa-calendar"/> Next: <field name="next_order_date"/>
                                </div>
                                <div>
                                    <i class="fa fa-cubes"/> <field name="asset_count"/> assets
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="assetz_maintenance_schedule_search" model="ir.ui.view">
        <field name="name">assetz.maintenance.schedule.search</field>
        <field name="model">assetz.maintenance.schedule</field>
        <field name="arch" type="xml">
            <search string="Search Schedules">
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
                <separator/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Paused" name="paused" domain="[('state', '=', 'paused')]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter string="Time-Based" name="time_based" domain="[('schedule_type', '=', 'time_based')]"/>
                <filter string="Usage-Based" name="usage_based" domain="[('schedule_type', '=', 'usage_based')]"/>
                <filter string="Hybrid" name="hybrid" domain="[('schedule_type', '=', 'hybrid')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'schedule_type'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Maintenance Type" name="group_maint_type" context="{'group_by': 'maintenance_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Actions                                                       -->
    <!-- ============================================================ -->

    <record id="action_maintenance_schedule" model="ir.actions.act_window">
        <field name="name">Maintenance Schedules</field>
        <field name="res_model">assetz.maintenance.schedule</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="assetz_maintenance_schedule_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first maintenance schedule
            </p>
            <p>
                Define preventive maintenance schedules based on time intervals
                or usage thresholds. Orders will be automatically generated when due.
            </p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Menu Items                                                    -->
    <!-- ============================================================ -->

    <menuitem id="menu_maintenance_schedules"
              name="Schedules"
              parent="assetz_menu_maintenance"
              action="action_maintenance_schedule"
              sequence="30" />

</odoo>
