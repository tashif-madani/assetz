<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- ============================================================== -->
    <!-- product.template form: add "Required Equipment" notebook tab    -->
    <!-- Visible only when product type = service.                       -->
    <!-- ============================================================== -->
    <record id="assetz_product_template_form_equipment" model="ir.ui.view">
        <field name="name">product.template.form.assetz.equipment</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Required Equipment"
                      name="assetz_equipment"
                      invisible="type != 'service'">
                    <field name="assetz_equipment_line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="equipment_id"
                                   domain="[('type', '!=', 'service')]"
                                   context="{'default_type': 'consu', 'default_sale_ok': True}" />
                            <field name="quantity" />
                            <field name="note" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ============================================================== -->
    <!-- Action + menu: Configuration → Services                         -->
    <!-- Shows product.product records filtered to type = service.       -->
    <!-- ============================================================== -->
    <record id="assetz_service_product_action" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('type', '=', 'service')]</field>
        <field name="context">{'default_type': 'service', 'default_sale_ok': True, 'default_purchase_ok': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define your service catalogue</p>
            <p>
                Each service is a service-typed <code>product.product</code>.
                In the <strong>Required Equipment</strong> tab on each service,
                list the equipment products needed to deliver it — they will
                auto-populate the <strong>Equipments</strong> tab on any order
                that uses the service.
            </p>
        </field>
    </record>

    <menuitem id="assetz_menu_service_catalogue"
              name="Services"
              parent="assetz_menu_configuration"
              sequence="32"
              action="assetz_service_product_action" />

    <!-- ============================================================== -->
    <!-- Action + menu: Configuration → Equipments                       -->
    <!-- Shows product.product records filtered to non-service products. -->
    <!-- ============================================================== -->
    <record id="assetz_equipment_product_action" model="ir.actions.act_window">
        <field name="name">Equipments</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('type', '!=', 'service')]</field>
        <field name="context">{'default_type': 'consu', 'default_sale_ok': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first equipment product</p>
            <p>
                Equipment products are consumables or storables used to deliver services.
                Once defined here, you can attach them to a service's
                <strong>Required Equipment</strong> tab, or pick them on an order's
                <strong>Equipments</strong> tab.
            </p>
        </field>
    </record>

    <menuitem id="assetz_menu_equipment_catalogue"
              name="Equipments"
              parent="assetz_menu_configuration"
              sequence="33"
              action="assetz_equipment_product_action" />

</odoo>
