<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dashboard Client Action -->
    <record id="assetz_dashboard_action" model="ir.actions.client">
        <field name="name">Asset Dashboard</field>
        <field name="tag">assetz_dashboard</field>
        <field name="target">current</field>
    </record>

    <!-- Dashboard Menu Item - Top of Assetz menu -->
    <menuitem id="assetz_menu_dashboard"
              name="Dashboard"
              parent="assetz_menu_root"
              action="assetz_dashboard_action"
              sequence="1"/>

</odoo>
