<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Service Contract Form View -->
    <record id="view_assetz_service_contract_form" model="ir.ui.view">
        <field name="name">assetz.service.contract.form</field>
        <field name="model">assetz.service.contract</field>
        <field name="arch" type="xml">
            <form string="Service Contract">
                <header>
                    <button
                        name="action_activate"
                        string="Activate"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_cancel"
                        string="Cancel"
                        type="object"
                        invisible="state in ('cancelled', 'expired')"
                    />
                    <button
                        name="action_set_draft"
                        string="Set to Draft"
                        type="object"
                        invisible="state not in ('cancelled', 'expired')"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,active,expired"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_claims"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                        >
                            <field name="claim_count" widget="statinfo" string="Claims" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                        <h2>
                            <field
                                name="display_name_custom"
                                placeholder="Contract Name..."
                            />
                        </h2>
                    </div>
                    <group>
                        <group string="Contract Details">
                            <field name="contract_type" />
                            <field name="provider_id" />
                            <field name="start_date" />
                            <field name="end_date" />
                            <field name="days_remaining" invisible="state != 'active'" />
                            <field name="is_valid" invisible="1" />
                        </group>
                        <group string="Coverage">
                            <field name="coverage_type" />
                            <field
                                name="parts_coverage_percent"
                                invisible="coverage_type not in ('parts_only', 'comprehensive', 'custom')"
                            />
                            <field
                                name="labor_coverage_percent"
                                invisible="coverage_type not in ('labor_only', 'comprehensive', 'custom')"
                            />
                            <field name="deductible_amount" />
                            <field name="currency_id" invisible="1" />
                        </group>
                    </group>
                    <group>
                        <group string="Coverage Limits">
                            <field name="max_claims_per_year" />
                            <field name="max_claim_value" />
                            <field name="annual_limit" />
                        </group>
                        <group string="Usage This Year" invisible="state != 'active'">
                            <field name="claims_this_year" />
                            <field name="total_claimed_this_year" />
                            <field
                                name="remaining_annual_limit"
                                invisible="annual_limit == 0"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Covered Assets" name="assets">
                            <group>
                                <group>
                                    <field name="apply_to_category" />
                                    <field
                                        name="category_id"
                                        invisible="not apply_to_category"
                                    />
                                </group>
                            </group>
                            <field
                                name="asset_ids"
                                widget="many2many_tags"
                                invisible="apply_to_category"
                                options="{'no_create': True}"
                            />
                            <p invisible="not apply_to_category" class="text-muted">
                                All assets in the selected category are covered by this
                                contract.
                            </p>
                        </page>
                        <page string="Exclusions" name="exclusions">
                            <field name="exclusion_ids">
                                <list editable="bottom">
                                    <field name="exclusion_type" />
                                    <field name="name" />
                                    <field name="notes" optional="hide" />
                                </list>
                            </field>
                        </page>
                        <page string="Terms &amp; Conditions" name="terms">
                            <field name="terms_and_conditions" />
                        </page>
                        <page string="Documents" name="documents">
                            <group>
                                <field
                                    name="contract_document"
                                    filename="contract_document_filename"
                                />
                                <field name="contract_document_filename" invisible="1" />
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes..." />
                        </page>
                    </notebook>
                    <field name="company_id" invisible="1" />
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Service Contract List View -->
    <record id="view_assetz_service_contract_tree" model="ir.ui.view">
        <field name="name">assetz.service.contract.list</field>
        <field name="model">assetz.service.contract</field>
        <field name="arch" type="xml">
            <list string="Service Contracts" decoration-danger="state == 'expired'" decoration-warning="days_remaining &lt; 30 and state == 'active'" decoration-muted="state == 'cancelled'">
                <field name="name" />
                <field name="display_name_custom" />
                <field name="contract_type" />
                <field name="provider_id" />
                <field name="start_date" />
                <field name="end_date" />
                <field name="days_remaining" />
                <field name="coverage_type" />
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-danger="state == 'expired'" decoration-warning="state == 'draft'" decoration-muted="state == 'cancelled'" />
            </list>
        </field>
    </record>

    <!-- Service Contract Search View -->
    <record id="view_assetz_service_contract_search" model="ir.ui.view">
        <field name="name">assetz.service.contract.search</field>
        <field name="model">assetz.service.contract</field>
        <field name="arch" type="xml">
            <search string="Search Contracts">
                <field name="name" />
                <field name="display_name_custom" />
                <field name="provider_id" />
                <field name="asset_ids" />
                <separator />
                <filter
                    name="active_contracts"
                    string="Active"
                    domain="[('state', '=', 'active')]"
                />
                <filter
                    name="draft_contracts"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    name="expired_contracts"
                    string="Expired"
                    domain="[('state', '=', 'expired')]"
                />
                <separator />
                <filter
                    name="warranties"
                    string="Warranties"
                    domain="[('contract_type', 'in', ['manufacturer_warranty', 'extended_warranty'])]"
                />
                <filter
                    name="amc"
                    string="AMC"
                    domain="[('contract_type', '=', 'amc')]"
                />
                <filter
                    name="service_agreements"
                    string="Service Agreements"
                    domain="[('contract_type', '=', 'service_agreement')]"
                />
                <separator />
                <filter
                    name="expiring_soon"
                    string="Expiring in 30 days"
                    domain="[('state', '=', 'active'), ('end_date', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%%Y-%%m-%%d'))]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="group_type"
                        string="Contract Type"
                        context="{'group_by': 'contract_type'}"
                    />
                    <filter
                        name="group_provider"
                        string="Provider"
                        context="{'group_by': 'provider_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Service Contract Kanban View -->
    <record id="view_assetz_service_contract_kanban" model="ir.ui.view">
        <field name="name">assetz.service.contract.kanban</field>
        <field name="model">assetz.service.contract</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_mobile">
                <field name="name" />
                <field name="display_name_custom" />
                <field name="contract_type" />
                <field name="provider_id" />
                <field name="end_date" />
                <field name="days_remaining" />
                <field name="state" />
                <field name="coverage_type" />
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-0">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name" />
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <strong>
                                        <field name="display_name_custom" />
                                    </strong>
                                </div>
                                <div>
                                    <field name="provider_id" />
                                </div>
                                <div>
                                    <field name="contract_type" /> -
                                    <field name="coverage_type" />
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span>Expires: <field name="end_date" /></span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="state" widget="label_selection" options="{'classes': {'draft': 'warning', 'active': 'success', 'expired': 'danger', 'cancelled': 'secondary'}}" />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Service Contract Action -->
    <record id="action_assetz_service_contract" model="ir.actions.act_window">
        <field name="name">Service Contracts</field>
        <field name="res_model">assetz.service.contract</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_assetz_service_contract_search" />
        <field name="context">{'search_default_active_contracts': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first service contract
            </p>
            <p>
                Track warranty, AMC, and service agreements for your assets.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem
        id="menu_assetz_contracts"
        name="Contracts"
        parent="assetz_menu_root"
        sequence="25"
    />

    <menuitem
        id="menu_assetz_service_contracts"
        name="Service Contracts"
        parent="menu_assetz_contracts"
        action="action_assetz_service_contract"
        sequence="10"
    />
</odoo>
