<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Category Tree View -->
    <record id="assetz_category_view_tree" model="ir.ui.view">
        <field name="name">assetz.category.view.tree</field>
        <field name="model">assetz.category</field>
        <field name="arch" type="xml">
            <list string="Categories">
                <field name="sequence" widget="handle" />
                <field name="code" optional="show" />
                <field name="name" />
                <field name="parent_id" optional="show" />
                <field name="code_prefix" optional="hide" />
                <field name="total_assets" string="Total" />
                <field name="available_count" string="Available" decoration-success="available_count > 0" />
                <field name="issued_count" string="Issued" decoration-warning="issued_count > 0" />
                <field name="reserved_count" string="Reserved" optional="show" />
                <field name="maintenance_count" string="Maintenance" optional="show" />
                <field name="require_approval" optional="hide" />
            </list>
        </field>
    </record>

    <!-- Category Form View -->
    <record id="assetz_category_view_form" model="ir.ui.view">
        <field name="name">assetz.category.view.form</field>
        <field name="model">assetz.category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assets" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="total_assets" widget="statinfo" string="Total Assets" />
                        </button>
                        <button name="action_view_available_assets" type="object" class="oe_stat_button" icon="fa-check-circle text-success">
                            <field name="available_count" widget="statinfo" string="Available" />
                        </button>
                        <button name="action_view_issued_assets" type="object" class="oe_stat_button" icon="fa-user text-warning">
                            <field name="issued_count" widget="statinfo" string="Issued" />
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <div class="oe_title">
                        <label for="name" string="Category Name" />
                        <h1>
                            <field name="name" placeholder="Category Name" />
                        </h1>
                        <span class="text-muted small">
                            <field name="example_category_name" nolabel="1" readonly="1" widget="char" />
                        </span>
                    </div>
                    <group>
                        <group string="Basic Information">
                            <field name="code" />
                            <field name="parent_id" />
                            <field name="sequence" />
                            <field name="color" widget="color_picker" />
                            <field name="active" invisible="1" />
                        </group>
                        <group string="Asset Defaults">
                            <label for="code_prefix" />
                            <div>
                                <field name="code_prefix" placeholder="Code Prefix" />
                                <span class="text-muted small">
                                    <field name="example_code_prefix" nolabel="1" readonly="1" widget="char" />
                                </span>
                            </div>
                            <field name="default_useful_life" />
                            <field name="depreciation_method" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Settings" name="settings">
                            <group>
                                <group string="Requirements">
                                    <field name="require_serial_number" />
                                    <field name="require_location" />
                                </group>
                                <group string="Approval &amp; Issuance">
                                    <field name="require_approval" />
                                    <field name="approver_ids" widget="many2many_tags" invisible="not require_approval" />
                                    <field name="require_request" />
                                </group>
                            </group>
                        </page>
                        <page string="Custom Attributes" name="attributes">
                            <div class="alert alert-info mb-3" role="alert">
                                <strong>Define custom specifications for assets in this category.</strong><br />
                                For Dropdown type: Click on an attribute row to open it and add the dropdown options.
                            </div>
                            <field name="attribute_ids" nolabel="1">
                                <list>
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                    <field name="attribute_type" />
                                    <field name="options_count" string="# Options" />
                                    <field name="is_required" />
                                    <field name="default_value" />
                                </list>
                            </field>
                        </page>
                        <page string="Stock Summary" name="stock_summary">
                            <group>
                                <group string="Asset Counts">
                                    <field name="total_assets" />
                                    <field name="available_count" />
                                    <field name="issued_count" />
                                    <field name="reserved_count" />
                                    <field name="maintenance_count" />
                                </group>
                                <group string="Actions">
                                    <div class="text-muted">
                                        <p>Click the stat buttons above to view assets by status.</p>
                                    </div>
                                </group>
                            </group>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" nolabel="1" placeholder="Category description..." />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Category Search View -->
    <record id="assetz_category_view_search" model="ir.ui.view">
        <field name="name">assetz.category.view.search</field>
        <field name="model">assetz.category</field>
        <field name="arch" type="xml">
            <search string="Search Categories">
                <field name="name" />
                <field name="code" />
                <field name="parent_id" />
                <separator />
                <filter name="filter_require_approval" string="Requires Approval" domain="[('require_approval', '=', True)]" />
                <separator />
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]" />
                <group expand="0" string="Group By">
                    <filter name="groupby_parent" string="Parent Category" context="{'group_by': 'parent_id'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Category Action -->
    <record id="assetz_category_action" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">assetz.category</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="assetz_category_view_tree" />
        <field name="search_view_id" ref="assetz_category_view_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first asset category
            </p>
            <p>
                Categories help organize assets and define common attributes and settings.
            </p>
        </field>
    </record>

    <!-- Category Attribute Form (popup) - for editing attributes with dropdown options -->
    <record id="assetz_category_attribute_view_form" model="ir.ui.view">
        <field name="name">assetz.category.attribute.view.form</field>
        <field name="model">assetz.category.attribute</field>
        <field name="arch" type="xml">
            <form string="Custom Attribute">
                <sheet>
                    <group>
                        <group string="Attribute Definition">
                            <label for="name" />
                            <div>
                                <field name="name" placeholder="Attribute Name" />
                                <span class="text-muted small">
                                    <field name="example_attribute_name" nolabel="1" readonly="1" widget="char" />
                                </span>
                            </div>
                            <field name="attribute_type" />
                            <field name="sequence" />
                        </group>
                        <group string="Settings">
                            <field name="is_required" />
                            <field name="default_value" invisible="attribute_type == 'selection'" placeholder="Default value" />
                            <field name="help_text" placeholder="Tooltip to help users" />
                        </group>
                    </group>
                    <group string="Dropdown Options" invisible="attribute_type != 'selection'" col="1">
                        <div class="alert alert-warning mb-2" role="alert" invisible="option_ids">
                            <strong>Required:</strong> Add at least one option for this dropdown attribute.
                        </div>
                        <span class="text-muted small mb-2">
                            <field name="example_attribute_options" nolabel="1" readonly="1" widget="char" />
                        </span>
                        <field name="option_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle" />
                                <field name="name" placeholder="Option value" />
                                <field name="is_default" string="Default" />
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Attribute Option Tree -->
    <record id="assetz_category_attribute_option_view_tree" model="ir.ui.view">
        <field name="name">assetz.category.attribute.option.view.tree</field>
        <field name="model">assetz.category.attribute.option</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" placeholder="Option value" />
                <field name="is_default" />
            </list>
        </field>
    </record>

    <!-- Stock Dashboard Kanban View -->
    <record id="assetz_category_stock_kanban" model="ir.ui.view">
        <field name="name">assetz.category.stock.kanban</field>
        <field name="model">assetz.category</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard" sample="1">
                <field name="name" />
                <field name="color" />
                <field name="total_assets" />
                <field name="available_count" />
                <field name="issued_count" />
                <field name="reserved_count" />
                <field name="maintenance_count" />
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click o_kanban_record_has_image_fill" t-att-style="'border-left: 4px solid ' + (record.color.raw_value ? '#' + record.color.raw_value.toString(16).padStart(6, '0') : '#875a7b')">
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top mb-2">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name" />
                                        </strong>
                                    </div>
                                </div>
                                <div class="container-fluid">
                                    <div class="row g-0 mb-1">
                                        <div class="col-6">
                                            <span class="text-muted">Total:</span>
                                        </div>
                                        <div class="col-6 text-end">
                                            <strong><field name="total_assets" /></strong>
                                        </div>
                                    </div>
                                    <div class="row g-0 mb-1">
                                        <div class="col-6">
                                            <span class="text-success"><i class="fa fa-check-circle" /> Available:</span>
                                        </div>
                                        <div class="col-6 text-end">
                                            <span class="badge text-bg-success"><field name="available_count" /></span>
                                        </div>
                                    </div>
                                    <div class="row g-0 mb-1">
                                        <div class="col-6">
                                            <span class="text-warning"><i class="fa fa-user" /> Issued:</span>
                                        </div>
                                        <div class="col-6 text-end">
                                            <span class="badge text-bg-warning"><field name="issued_count" /></span>
                                        </div>
                                    </div>
                                    <div class="row g-0 mb-1">
                                        <div class="col-6">
                                            <span class="text-info"><i class="fa fa-clock-o" /> Reserved:</span>
                                        </div>
                                        <div class="col-6 text-end">
                                            <span class="badge text-bg-info"><field name="reserved_count" /></span>
                                        </div>
                                    </div>
                                    <div class="row g-0">
                                        <div class="col-6">
                                            <span class="text-secondary"><i class="fa fa-wrench" /> Maintenance:</span>
                                        </div>
                                        <div class="col-6 text-end">
                                            <span class="badge text-bg-secondary"><field name="maintenance_count" /></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Stock Dashboard Kanban View (Read-Only for reporting) -->
    <record id="assetz_category_stock_kanban_readonly" model="ir.ui.view">
        <field name="name">assetz.category.stock.kanban.readonly</field>
        <field name="model">assetz.category</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard" sample="1" create="0" edit="0" delete="0">
                <field name="name" />
                <field name="color" />
                <field name="total_assets" />
                <field name="available_count" />
                <field name="issued_count" />
                <field name="reserved_count" />
                <field name="maintenance_count" />
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click o_kanban_record_has_image_fill" t-att-style="'border-left: 4px solid ' + (record.color.raw_value ? '#' + record.color.raw_value.toString(16).padStart(6, '0') : '#875a7b')">
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top mb-2">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name" />
                                        </strong>
                                    </div>
                                </div>
                                <div class="container-fluid">
                                    <div class="row g-0 mb-1">
                                        <div class="col-6">
                                            <span class="text-muted">Total:</span>
                                        </div>
                                        <div class="col-6 text-end">
                                            <strong><field name="total_assets" /></strong>
                                        </div>
                                    </div>
                                    <div class="row g-0 mb-1">
                                        <div class="col-6">
                                            <span class="text-success"><i class="fa fa-check-circle" /> Available:</span>
                                        </div>
                                        <div class="col-6 text-end">
                                            <span class="badge text-bg-success"><field name="available_count" /></span>
                                        </div>
                                    </div>
                                    <div class="row g-0 mb-1">
                                        <div class="col-6">
                                            <span class="text-warning"><i class="fa fa-user" /> Issued:</span>
                                        </div>
                                        <div class="col-6 text-end">
                                            <span class="badge text-bg-warning"><field name="issued_count" /></span>
                                        </div>
                                    </div>
                                    <div class="row g-0 mb-1">
                                        <div class="col-6">
                                            <span class="text-info"><i class="fa fa-clock-o" /> Reserved:</span>
                                        </div>
                                        <div class="col-6 text-end">
                                            <span class="badge text-bg-info"><field name="reserved_count" /></span>
                                        </div>
                                    </div>
                                    <div class="row g-0">
                                        <div class="col-6">
                                            <span class="text-secondary"><i class="fa fa-wrench" /> Maintenance:</span>
                                        </div>
                                        <div class="col-6 text-end">
                                            <span class="badge text-bg-secondary"><field name="maintenance_count" /></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Stock Dashboard List View (Read-Only) -->
    <record id="assetz_category_stock_tree_readonly" model="ir.ui.view">
        <field name="name">assetz.category.stock.tree.readonly</field>
        <field name="model">assetz.category</field>
        <field name="arch" type="xml">
            <list string="Stock Summary" create="0" edit="0" delete="0" export_xlsx="1">
                <field name="code" optional="show" />
                <field name="name" />
                <field name="parent_id" optional="show" />
                <field name="total_assets" string="Total" sum="Total Assets" />
                <field name="available_count" string="Available" decoration-success="available_count > 0" sum="Available" />
                <field name="issued_count" string="Issued" decoration-warning="issued_count > 0" sum="Issued" />
                <field name="reserved_count" string="Reserved" sum="Reserved" />
                <field name="maintenance_count" string="Maintenance" sum="In Maintenance" />
            </list>
        </field>
    </record>

    <!-- Stock Dashboard Action -->
    <record id="assetz_stock_dashboard_action" model="ir.actions.act_window">
        <field name="name">Stock Dashboard</field>
        <field name="res_model">assetz.category</field>
        <field name="view_mode">kanban,list</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('assetz_category_stock_kanban_readonly')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('assetz_category_stock_tree_readonly')})]" />
        <field name="domain">[('active', '=', True)]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No categories found
            </p>
            <p>
                Create asset categories to see stock levels here.
            </p>
        </field>
    </record>

    <!-- Stock Dashboard Menu - Added to Reporting menu in asset_views.xml -->
</odoo>
