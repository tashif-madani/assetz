<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Reservation Tree View -->
    <record id="assetz_reservation_view_tree" model="ir.ui.view">
        <field name="name">assetz.reservation.view.tree</field>
        <field name="model">assetz.reservation</field>
        <field name="arch" type="xml">
            <list string="Reservations" decoration-warning="is_expired" decoration-muted="state == 'cancelled'">
                <field name="name" />
                <field name="reservation_date" />
                <field name="recipient_type" />
                <field name="recipient_display" />
                <field name="valid_from" />
                <field name="valid_until" />
                <field name="asset_count" string="Assets" />
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'" decoration-warning="state == 'expired'" decoration-muted="state in ('cancelled', 'converted')" />
                <field name="is_expired" column_invisible="1" />
            </list>
        </field>
    </record>

    <!-- Reservation Form View -->
    <record id="assetz_reservation_view_form" model="ir.ui.view">
        <field name="name">assetz.reservation.view.form</field>
        <field name="model">assetz.reservation</field>
        <field name="arch" type="xml">
            <form string="Asset Reservation">
                <header>
                    <button name="action_confirm" type="object" string="Confirm Reservation" class="btn-primary" invisible="state != 'draft'" />
                    <button name="action_convert_to_issue" type="object" string="Convert to Issue Order" class="btn-primary" invisible="state != 'confirmed'" />
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'confirmed')" />
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state not in ('confirmed', 'cancelled', 'expired')" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,converted" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(assetz.assetz_issue_order_action)d" type="action" class="oe_stat_button" icon="fa-exchange" invisible="not issue_order_id">
                            <span class="o_stat_text">Issue Order</span>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-warning" invisible="not is_expired" />
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancelled'" />
                    <div class="oe_title">
                        <label for="name" string="Reservation Reference" />
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group string="Reserve For">
                            <field name="recipient_type" readonly="state != 'draft'" />
                            <field name="employee_id" invisible="recipient_type != 'employee'" readonly="state != 'draft'" />
                            <field name="user_id" invisible="recipient_type != 'user'" readonly="state != 'draft'" />
                            <field name="partner_id" invisible="recipient_type != 'partner'" readonly="state != 'draft'" />
                            <field name="department_id" invisible="recipient_type != 'department'" readonly="state != 'draft'" />
                            <field name="location_id" invisible="recipient_type != 'location'" readonly="state != 'draft'" />
                            <field name="project_name" invisible="recipient_type != 'project'" readonly="state != 'draft'" />
                            <field name="cost_center" invisible="recipient_type != 'cost_center'" readonly="state != 'draft'" />
                            <field name="recipient_name" invisible="recipient_type != 'other'" readonly="state != 'draft'" />
                            <field name="recipient_display" invisible="1" />
                        </group>
                        <group string="Reservation Period">
                            <field name="reservation_date" readonly="state != 'draft'" />
                            <field name="valid_from" readonly="state != 'draft'" />
                            <field name="valid_until" readonly="state != 'draft'" />
                            <field name="is_expired" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Assets" name="assets">
                            <field name="line_ids" nolabel="1" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="asset_id" />
                                    <field name="asset_code" />
                                    <field name="asset_category_id" />
                                    <field name="serial_number" />
                                    <field name="notes" />
                                </list>
                            </field>
                        </page>
                        <page string="Additional Information" name="additional">
                            <group>
                                <group>
                                    <field name="reason" readonly="state not in ('draft', 'confirmed')" />
                                </group>
                                <group>
                                    <field name="notes" readonly="state not in ('draft', 'confirmed')" />
                                </group>
                            </group>
                            <group invisible="not issue_order_id">
                                <group string="Conversion">
                                    <field name="issue_order_id" readonly="1" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                    <field name="company_id" invisible="1" />
                </sheet>
            </form>
        </field>
    </record>

    <!-- Reservation Search View -->
    <record id="assetz_reservation_view_search" model="ir.ui.view">
        <field name="name">assetz.reservation.view.search</field>
        <field name="model">assetz.reservation</field>
        <field name="arch" type="xml">
            <search string="Search Reservations">
                <field name="name" />
                <field name="recipient_display" />
                <field name="employee_id" />
                <field name="department_id" />
                <separator />
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]" />
                <filter name="filter_confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]" />
                <filter name="filter_expired" string="Expired" domain="[('state', '=', 'expired')]" />
                <filter name="filter_converted" string="Converted" domain="[('state', '=', 'converted')]" />
                <separator />
                <filter name="filter_active" string="Active Reservations" domain="[('state', '=', 'confirmed'), ('is_expired', '=', False)]" />
                <separator />
                <group expand="0" string="Group By">
                    <filter name="groupby_state" string="Status" context="{'group_by': 'state'}" />
                    <filter name="groupby_recipient_type" string="Recipient Type" context="{'group_by': 'recipient_type'}" />
                    <filter name="groupby_valid_until" string="Valid Until" context="{'group_by': 'valid_until'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Reservation Action -->
    <record id="assetz_reservation_action" model="ir.actions.act_window">
        <field name="name">Asset Reservations</field>
        <field name="res_model">assetz.reservation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="assetz_reservation_view_search" />
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first asset reservation
            </p>
            <p>
                Reserve assets for employees, departments, or projects before issuing them.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="assetz_menu_reservations" name="Reservations" parent="assetz.assetz_menu_operations" sequence="15" action="assetz_reservation_action" />
</odoo>
