                <field name="name" />
                <field name="category_id" />
                <field name="location_id" />
                <field name="acquisition_date" />
                <field name="acquisition_cost" sum="Total Acquisition Cost" />
                <field name="useful_life_years" optional="show" />
                <field name="salvage_value" sum="Total Salvage Value" optional="show" />
                <field name="age_days" string="Age (Days)" />
                <field name="state" widget="badge" />
            </list>
        </field>
    </record>

    <!-- Asset Valuation Report Pivot View -->
    <record id="assetz_asset_valuation_pivot" model="ir.ui.view">
        <field name="name">assetz.asset.valuation.pivot</field>
        <field name="model">assetz.asset</field>
        <field name="arch" type="xml">
            <pivot string="Asset Valuation Analysis" disable_linking="1">
                <field name="category_id" type="row" />
                <field name="location_id" type="row" />
                <field name="acquisition_cost" type="measure" />
                <field name="salvage_value" type="measure" />
            </pivot>
        </field>
