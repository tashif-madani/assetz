    <!-- Asset Valuation Report Search View -->
    <record id="assetz_asset_valuation_report_search" model="ir.ui.view">
        <field name="name">assetz.asset.valuation.report.search</field>
        <field name="model">assetz.asset</field>
        <field name="arch" type="xml">
            <search string="Valuation Report">
                <field name="name" />
                <field name="code" />
                <field name="category_id" />
                <field name="location_id" />
                <separator />
                <filter name="filter_active" string="Active Assets" domain="[('state', '=', 'active')]" />
                <filter name="filter_retired" string="Retired Assets" domain="[('state', '=', 'retired')]" />
                <separator />
                <filter name="filter_this_year" string="Acquired This Year" domain="[('acquisition_date', '&gt;=', (context_today().replace(month=1, day=1)).strftime('%Y-%m-%d'))]" />
                <filter name="filter_last_year" string="Acquired Last Year" domain="[('acquisition_date', '&gt;=', (context_today().replace(month=1, day=1, year=context_today().year-1)).strftime('%Y-%m-%d')), ('acquisition_date', '&lt;', (context_today().replace(month=1, day=1)).strftime('%Y-%m-%d'))]" />
                <separator />
                <group expand="0" string="Group By">
                    <filter name="groupby_category" string="Category" context="{'group_by': 'category_id'}" />
                    <filter name="groupby_location" string="Location" context="{'group_by': 'location_id'}" />
                    <filter name="groupby_state" string="Status" context="{'group_by': 'state'}" />
                    <filter name="groupby_acquisition_year" string="Acquisition Year" context="{'group_by': 'acquisition_date:year'}" />
                    <filter name="groupby_acquisition_month" string="Acquisition Month" context="{'group_by': 'acquisition_date:month'}" />
                </group>
            </search>
        </field>
    </record>

